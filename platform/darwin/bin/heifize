#!/usr/bin/env bash

# heifize
# Creates HEIF copies of image file arguments, while preserving metadata

set -euo pipefail

if [[ $# = 0 ]]; then
    echo "usage: $(basename $0) [<image>...] <image>"
    echo
    echo "Parameters:"
    echo "    image        any image file sips supports"
    echo
    echo "If multiple CPU cores are present, the operations will be parallelised to run on all cores."
    exit
fi

CPU_COUNT=$(sysctl -n hw.logicalcpu_max)

if [[ $# -gt 1 ]] && [[ $CPU_COUNT -gt 1 ]]; then
    echo "More than one file, and more than one core: running on all CPU cores" >&2
    printf "%s\0" "$@" | xargs -0 -P $CPU_COUNT -n 1 "$0"
else
    for ARG in "$@"; do
        CREATED_DATE="$(GetFileInfo -d "$ARG")"
        OUTPUT_FILE="${ARG%.*}.heic"

        sips -s format heic \
             "$ARG" \
             -o "$OUTPUT_FILE"

        SetFile -d "$CREATED_DATE" \
                -m "$CREATED_DATE" \
                "$OUTPUT_FILE"

        rm "$ARG"
    done
fi
